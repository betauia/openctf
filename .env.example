# Template for the env file loaded by compose.yaml (see .env.dev for working dev values).
# Non-secret settings (INSTANCE_PROVIDER, HOST_DOMAIN, UPLOAD_DIR, ADDR) live in compose.yaml.

# Signs session tokens. Generate with: openssl rand -hex 32
SECRET_KEY=''

# Password for the Postgres "openctf" user. Use letters and digits only so it's safe inside DATABASE_URL.
POSTGRES_PASSWORD=''

# Must use the same password as POSTGRES_PASSWORD. "database" is the compose service name.
DATABASE_URL='postgres://openctf:<POSTGRES_PASSWORD>@database:5432/openctf?sslmode=disable'
