{
  "name": "openctf-frontend",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.17.0"
  },
  "imports": {
    "#components/*": "./src/lib/components/*",
    "#assets/*": "./src/lib/assets/*",
    "#library/*": "./src/lib/*",
    "#styles/*": "./src/styles/*"
  },
  "scripts": {
    "dev": "svelte-kit sync && vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:layout": "playwright test",
    "test:layout:docker": "docker run --rm --network host -e OCTF_USER -e OCTF_PASS -e OCTF_URL -v \"$PWD\":/app -w /app mcr.microsoft.com/playwright:v1.65.1-noble npx playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "lucide-svelte": "^0.556.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@sveltejs/adapter-node": "^6.0.5",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.0",
    "vite": "^8.3.8"
  }
}
