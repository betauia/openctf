---
import AdminLayout from '@layouts/AdminLayout.astro';
import { BACKEND_URL } from "@library/backend";

export const prerender = false;

const { id } = Astro.params;

const response = await fetch(`${BACKEND_URL}/api/instances/${id}`);
const instance = await response.json();
---

<AdminLayout pageTitle={`Container: ${id}`}>
  <div class="container-page">
    <div class="flex flex-col items-center gap-4 mt-4 border border-raised rounded-[20px] p-4">
        <div class="info-section">
          <h3>Basic Info</h3>
          <p><strong>ID:</strong> {instance.id}</p>
          <p><strong>Name:</strong> {instance.name}</p>
          <p><strong>Image:</strong> {instance.image}</p>
          <p><strong>Status:</strong> {instance.status}</p>
          <p><strong>Created:</strong> {new Date(instance.created_at).toLocaleString()}</p>
          <p><strong>Provider:</strong> {instance.provider}</p>
        </div>
  </div>
</AdminLayout>
