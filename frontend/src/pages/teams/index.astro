---
import TeamsLayout from "@layouts/TeamsLayout.astro";
import { ArrowLeft } from "@lucide/astro";
import TeamTab from "@components/teams/TeamTab.astro";
import LeaderboardTab from "@components/teams/LeaderboardTab.astro";
import { cookieOf, apiFetch } from "@library/backend";

const cookie = cookieOf(Astro.request);

let myTeam: any = null;
let teams: any[] = [];
let me: any = null;
let activity: any[] = [];

try {
  const meRes = await apiFetch(cookie, "/api/auth/me");
  if (!meRes.ok) throw null;
  me = await meRes.json();

  const [myTeamRes, teamsRes, actRes] = await Promise.all([
    apiFetch(cookie, "/api/teams/my"),
    apiFetch("",     "/api/teams"),
    apiFetch(cookie, "/api/teams/activity"),
  ]);
  if (myTeamRes.ok) myTeam = await myTeamRes.json();
  if (teamsRes.ok)  teams  = await teamsRes.json();
  if (actRes.ok)    activity = await actRes.json();
} catch {
  return Astro.redirect("/login");
}

const myRank        = myTeam ? teams.findIndex((t: any) => t.id === myTeam.id) + 1 : null;
const sortedMembers = (myTeam?.members ?? []).toSorted((a: any, b: any) => b.score - a.score);
const inspectMemberId = Number(Astro.url.searchParams.get("member"));
const pageData      = JSON.stringify({ teams, inspectMemberId }).replace(/</g, "\\u003c");
---

<TeamsLayout pageTitle="Teams - OpenCTF">
  <div class="flex flex-col h-[calc(100vh-64px)] mt-16 bg-raised">
    <div class="flex items-center bg-background border-b border-border-subtle shrink-0 px-5">
      <button
        data-tab="team"
        class="tm-tab active flex items-center h-11 px-4 bg-transparent border-none border-b-2 border-transparent
               text-text/35 text-[11px] tracking-[0.1em] cursor-pointer transition-colors duration-100
               -mb-px hover:text-muted-text [&.active]:text-accent [&.active]:border-b-accent"
      >My Team</button>
      <button
        data-tab="leaderboard"
        class="tm-tab flex items-center h-11 px-4 bg-transparent border-none border-b-2 border-transparent
               text-text/35 text-[11px] tracking-[0.1em] cursor-pointer transition-colors duration-100
               -mb-px hover:text-muted-text [&.active]:text-accent [&.active]:border-b-accent"
      >Leaderboard</button>
    </div>

    <TeamTab myTeam={myTeam} me={me} myRank={myRank} sortedMembers={sortedMembers} activity={activity} />
    <LeaderboardTab teams={teams} myTeam={myTeam} />
  </div>

  <div id="tm-icon-cache" style="display:none">
    <span data-icon="arrow-left"><ArrowLeft size={14} /></span>
  </div>

  <script id="tm-data" type="application/json" set:html={pageData} is:inline />
</TeamsLayout>

<script>
  import "@scripts/teams";
</script>
