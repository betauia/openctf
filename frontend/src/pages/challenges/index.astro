---
import ChallengesLayout from "@layouts/ChallengesLayout.astro";
import Sidebar from "@components/challenges/Sidebar.astro";
import StatsBar from "@components/challenges/StatsBar.astro";
import ActionBar from "@components/challenges/ActionBar.astro";
import ChallengeTable from "@components/challenges/ChallengeTable.astro";
import ChallengeModal from "@components/challenges/ChallengeModal.astro";
import "@styles/challenges.css";
import "@styles/challenges-table.css";
import "@styles/challenges-modal.css";

let challenges: any[] = [];
try {
  const res = await fetch("http://backend:8000/api/challenges");
  if (res.ok) challenges = await res.json();
} catch {}

const categories = [...new Set(challenges.map((c) => c.category))].sort() as string[];
const totalSolves = challenges.reduce((s, c) => s + (c.solves ?? 0), 0);
const totalPoints = challenges.reduce((s, c) => s + (c.points ?? 0), 0);
---

<ChallengesLayout pageTitle="Challenges - OpenCTF">
  <div class="ch-layout">
    <Sidebar {categories} {challenges} />
    <main class="ch-main">
      <StatsBar count={challenges.length} {totalSolves} {totalPoints} />
      <ActionBar />
      <ChallengeTable {challenges} />
    </main>
  </div>

  <script id="ch-data" type="application/json" set:html={JSON.stringify(challenges)} />
  <ChallengeModal />
</ChallengesLayout>

<script>
  const challenges: any[] = JSON.parse(document.getElementById("ch-data")!.textContent!);

  const css = getComputedStyle(document.documentElement);
  const CAT_COLORS: Record<string, string> = Object.fromEntries(
    ["web","pwn","crypto","rev","hardware","misc"].map((c) => [c, css.getPropertyValue(`--cat-${c}`).trim()])
  );
  const DIFF_COLORS: Record<string, string> = Object.fromEntries(
    ["easy","medium","hard","insane"].map((d) => [d, css.getPropertyValue(`--diff-${d}`).trim()])
  );

  // solved
  const SOLVED_KEY = "openctf_solved";
  const solvedIds = new Set<number>(JSON.parse(localStorage.getItem(SOLVED_KEY) ?? "[]"));
  let solvedCollapsed = localStorage.getItem("openctf_solved_collapsed") === "true";

  const tbody = document.querySelector<HTMLTableSectionElement>("#ch-table tbody")!;
  const solvedSep = document.getElementById("ch-solved-sep")!;
  const solvedArrow = document.getElementById("ch-solved-arrow")!;
  const solvedCount = document.getElementById("ch-solved-count")!;

  function updateSolvedUI() {
    solvedCount.textContent = solvedIds.size > 0 ? `(${solvedIds.size})` : "";
    solvedArrow.textContent = solvedCollapsed ? "▶" : "▼";
  }

  function initSolvedRows() {
    solvedIds.forEach((id) => {
      const row = tbody.querySelector<HTMLTableRowElement>(`.ch-row[data-id="${id}"]`);
      if (row) { row.classList.add("ch-solved"); tbody.appendChild(row); }
    });
    if (solvedIds.size > 0) tbody.insertBefore(solvedSep, tbody.querySelector(".ch-solved")!);
    updateSolvedUI();
    filterRows();
  }

  function markChallengeSolved(id: number) {
    if (solvedIds.has(id)) return;
    solvedIds.add(id);
    localStorage.setItem(SOLVED_KEY, JSON.stringify([...solvedIds]));
    const row = tbody.querySelector<HTMLTableRowElement>(`.ch-row[data-id="${id}"]`);
    if (row) {
      row.classList.add("ch-solved");
      if (!tbody.contains(solvedSep)) tbody.appendChild(solvedSep);
      tbody.appendChild(row);
    }
    updateSolvedUI();
    filterRows();
  }

  document.getElementById("ch-solved-toggle")!.addEventListener("click", () => {
    solvedCollapsed = !solvedCollapsed;
    localStorage.setItem("openctf_solved_collapsed", String(solvedCollapsed));
    updateSolvedUI();
    filterRows();
  });

  // filter
  const rows = document.querySelectorAll<HTMLTableRowElement>("#ch-table tbody .ch-row");
  const searchInput = document.getElementById("ch-search") as HTMLInputElement;
  const catBtns = document.querySelectorAll<HTMLButtonElement>(".ch-cat");

  let activeCat = "all";
  let searchQuery = "";

  function filterRows() {
    let visibleSolved = 0;
    rows.forEach((row) => {
      const isSolved = row.classList.contains("ch-solved");
      const match =
        (activeCat === "all" || row.dataset.cat === activeCat) &&
        (row.dataset.name ?? "").includes(searchQuery);
      if (isSolved) {
        row.style.display = match && !solvedCollapsed ? "" : "none";
        if (match) visibleSolved++;
      } else {
        row.style.display = match ? "" : "none";
      }
    });
    const anyMatchSolved = solvedCollapsed && [...solvedIds].some((id) => {
      const r = tbody.querySelector<HTMLTableRowElement>(`.ch-row[data-id="${id}"]`);
      return r && (activeCat === "all" || r.dataset.cat === activeCat) && (r.dataset.name ?? "").includes(searchQuery);
    });
    solvedSep.style.display = visibleSolved > 0 || anyMatchSolved ? "" : "none";
  }

  catBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      catBtns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      activeCat = btn.dataset.cat ?? "all";
      filterRows();
    });
  });

  searchInput?.addEventListener("input", () => {
    searchQuery = searchInput.value.toLowerCase();
    filterRows();
  });

  // flag submit
  async function submitFlag(
    flag: string,
    btn: HTMLButtonElement,
    input: HTMLInputElement,
    msg?: HTMLElement,
    onCorrect?: (title: string) => void,
  ) {
    btn.disabled = true;
    btn.textContent = "...";
    if (msg) { msg.textContent = ""; msg.className = msg.className.replace(/ ?(correct|wrong)/g, ""); }

    try {
      const res = await fetch("/api/challenges/submit", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ flag }),
      });
      const data = await res.json();

      if (data.correct) {
        btn.textContent = `+${data.points}!`;
        btn.classList.add("correct");
        input.value = "";
        if (msg) { msg.textContent = `Correct! +${data.points} points`; msg.classList.add("correct"); }
        onCorrect?.(data.challenge);
      } else {
        btn.textContent = "Wrong";
        btn.classList.add("wrong");
        if (msg) { msg.textContent = "Incorrect flag, try again."; msg.classList.add("wrong"); }
      }
    } catch {
      btn.textContent = "Error";
      btn.classList.add("wrong");
    }

    setTimeout(() => {
      btn.textContent = "Submit";
      btn.disabled = false;
      btn.classList.remove("correct", "wrong");
    }, 2000);
  }

  const flagForm  = document.getElementById("ch-flag-form") as HTMLFormElement;
  const flagInput = document.getElementById("ch-flag") as HTMLInputElement;
  const flagBtn   = document.getElementById("ch-flag-btn") as HTMLButtonElement;

  flagForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    const flag = flagInput.value.trim();
    if (flag) submitFlag(flag, flagBtn, flagInput, undefined, (title) => {
      const id = challenges.find((c: any) => c.title === title)?.id;
      if (id) markChallengeSolved(id);
    });
  });

  // modal
  let currentModalId: number | null = null;
  const overlay = document.getElementById("ch-overlay")!;

  const mTitle  = document.getElementById("m-title")!;
  const mBadges = document.getElementById("m-badges")!;
  const mDesc   = document.getElementById("m-desc")!;
  const mMeta   = document.getElementById("m-meta")!;

  const mConnBlock = document.getElementById("m-conn-block")!;
  const mConn      = document.getElementById("m-conn")!;

  const mFileBlock = document.getElementById("m-file-block")!;
  const mFileLink  = document.getElementById("m-file-link") as HTMLAnchorElement;

  const mFlagForm  = document.getElementById("m-flag-form") as HTMLFormElement;
  const mFlagInput = document.getElementById("m-flag") as HTMLInputElement;
  const mFlagBtn   = document.getElementById("m-flag-btn") as HTMLButtonElement;
  const mFlagMsg   = document.getElementById("m-flag-msg")!;

  const KEEP_LOWER = new Set(["pwn", "rev"]);
  const fmt = (s: string) => { const l = s.toLowerCase(); return KEEP_LOWER.has(l) ? l : l[0].toUpperCase() + l.slice(1); };

  function badge(text: string, color: string) {
    return `<span style="display:inline-block;padding:3px 10px;font-size:10px;letter-spacing:.08em;font-weight:600;color:${color};background:${color}20;border:1px solid ${color}40">${text}</span>`;
  }

  function openModal(id: number) {
    currentModalId = id;
    const c = challenges.find((x) => x.id === id);
    if (!c) return;

    const catColor  = CAT_COLORS[c.category] ?? "#888";
    const diffColor = DIFF_COLORS[(c.difficulty ?? "").toLowerCase()] ?? "#888";

    mTitle.textContent = c.title;
    mBadges.innerHTML =
      badge(fmt(c.category), catColor) +
      badge(c.difficulty ? fmt(c.difficulty) : "—", diffColor) +
      badge(`${c.points} pts`, css.getPropertyValue("--pts-color").trim());

    mDesc.textContent = c.description ?? "No description provided.";

    mMeta.innerHTML = [
      ["Author", c.author,      "rgba(255,255,255,0.8)"],
      ["Points", c.points,      css.getPropertyValue("--pts-color").trim()],
      ["Solves", c.solves ?? 0, "rgba(255,255,255,0.8)"],
    ].map(([k, v, color]) => `
      <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 12px;border-bottom:1px solid rgba(255,255,255,0.04)">
        <span style="font-size:11px;color:rgba(255,255,255,0.35)">${k}</span>
        <span style="font-size:12px;font-weight:600;color:${color}">${v}</span>
      </div>`).join("");

    mConnBlock.style.display = c.connection_info ? "" : "none";
    mConn.textContent = c.connection_info ?? "";

    mFileBlock.style.display = c.file_path ? "" : "none";
    mFileLink.href = `/api/challenges/${c.id}/file`;
    mFileLink.textContent = `↓ ${c.file_path ?? ""}`;

    mFlagInput.value = "";
    mFlagMsg.textContent = "";
    mFlagMsg.className = "ch-modal-flag-msg";
    mFlagBtn.textContent = "Submit";
    mFlagBtn.disabled = false;
    mFlagBtn.className = "";

    overlay.classList.add("open");
    mFlagInput.focus();
  }

  function closeModal() { overlay.classList.remove("open"); }

  document.querySelectorAll<HTMLTableRowElement>(".ch-row").forEach((row) => {
    row.addEventListener("click", () => openModal(Number(row.dataset.id)));
  });

  document.getElementById("ch-modal-close")!.addEventListener("click", closeModal);
  overlay.addEventListener("click", (e) => { if (e.target === overlay) closeModal(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeModal(); });

  mFlagForm.addEventListener("submit", (e) => {
    e.preventDefault();
    const flag = mFlagInput.value.trim();
    if (flag) submitFlag(flag, mFlagBtn, mFlagInput, mFlagMsg, () => {
      if (currentModalId) markChallengeSolved(currentModalId);
    });
  });

  initSolvedRows();
</script>
