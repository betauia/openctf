---
import { CAT_DEFS, DIFF_DEFS } from "@library/categories";

const all = [
  ...CAT_DEFS.map((c) => ({ prefix: "cat", ...c })),
  ...DIFF_DEFS.map((d) => ({ prefix: "diff", ...d })),
];

const cssVar = (x: (typeof all)[number]) => `--${x.prefix}-${x.slug}: ${x.color};`;

const cssBadge = (x: (typeof all)[number]) => `
  .${x.prefix}-${x.slug} {
    color: var(--${x.prefix}-${x.slug});
    background: color-mix(in srgb, var(--${x.prefix}-${x.slug}) 12%, transparent);
  }`;

const vars = all.map(cssVar).join("\n  ");
const badges = all.map(cssBadge).join("\n");

const styleTag = `<style>
  :root {
  ${vars}
  }
  ${badges}
</style>`;
---

<Fragment set:html={styleTag} />
