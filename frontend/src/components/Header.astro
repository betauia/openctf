---
import "../styles/navbar.css";
import logo from "@assets/logo.png";
import { cookieOf, apiFetch } from "@lib/backend";

const links = [
  { name: "Challenges", href: "/challenges" },
  { name: "Scoreboard", href: "/scoreboard" },
  { name: "Teams", href: "/teams" },
  { name: "Rules", href: "/rules" },
];

const cookie = cookieOf(Astro.request);
const path = Astro.url.pathname;
let user: { username: string } | null = null;

try {
  const r = await apiFetch(cookie, "/api/auth/me");
  if (r.ok) user = await r.json();
} catch {}
---

<nav>
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <img src={logo.src} alt="Logo" class="nav-logo-img" />
    </a>

    <ul class="nav-links">
      {links.map((link) => (
        <li>
          <a href={link.href} class={path.startsWith(link.href) ? "active" : ""}>
            {link.name}
          </a>
        </li>
      ))}
    </ul>

    <div class="nav-user">
      {user ? (
        <>
          <div class="nav-avatar">{user.username[0].toUpperCase()}</div>
          <button class="nav-logout" id="nav-logout-btn">Logout</button>
        </>
      ) : (
        <a href="/login" class="nav-login">Login</a>
      )}
    </div>
  </div>
</nav>

<script>
  document.getElementById("nav-logout-btn")?.addEventListener("click", async () => {
    await fetch("/api/auth/logout", { method: "POST" });
    window.location.href = "/";
  });
</script>
