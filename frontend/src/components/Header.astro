---
import "../styles/navbar.css";
import logo from "@assets/logo.png";

const links = [
  { name: "Challenges", href: "/challenges" },
  { name: "Scoreboard", href: "/scoreboard" },
  { name: "Teams", href: "/teams" },
  { name: "Rules", href: "/rules" },
];

const cookie = Astro.request.headers.get("cookie") ?? "";
let user: { username: string } | null = null;
try {
  const r = await fetch("http://backend:8000/api/auth/me", { headers: { cookie } });
  if (r.ok) user = await r.json();
} catch {}
---

<nav class="w-full">
  <div class="navbar-container nav-inner">
    <a href="/" class="logo">
      <img src={logo.src} alt="Logo" class="logo-img" />
    </a>

    <ul class="nav-links">
      {links.map((link) => (
        <li><a href={link.href}>{link.name}</a></li>
      ))}
    </ul>

    <div class="nav-user">
      {user ? (
        <>
          <span class="nav-username">{user.username}</span>
          <button class="nav-logout" id="nav-logout-btn">Logout</button>
        </>
      ) : (
        <a href="/login" class="nav-login">Login</a>
      )}
    </div>
  </div>
</nav>

<script>
  document.getElementById("nav-logout-btn")?.addEventListener("click", async () => {
    await fetch("/api/auth/logout", { method: "POST" });
    window.location.href = "/";
  });
</script>
