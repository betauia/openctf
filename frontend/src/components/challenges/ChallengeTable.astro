---
import { CAT_MAP } from "@library/categories";
import { fmt } from "@library/utils";
const { challenges } = Astro.props;

const th = (center: boolean) =>
  `py-2 px-3 text-[11px] tracking-[0.12em] text-text/55 ${center ? "text-center" : "text-left"}`;
const td = (extra: string, center = false) =>
  `py-2.5 px-3 text-[13px] ${extra}${center ? " text-center" : ""}`;
---

<div class="flex-1 overflow-y-auto p-4">
  {challenges.length === 0 ? (
    <div class="text-center py-20 text-text/18 text-[13px]">No challenges available</div>
  ) : (
    <table id="ch-table" class="w-full border-separate border-spacing-x-0 border-spacing-y-0.5">

      <thead>
        <tr class="border-b border-border-subtle">
          {["#", "Challenges", "Category", "Solves", "Points", "Difficulty"].map((h, i) => (
            <th class={th(i >= 2)}>{h}</th>
          ))}
        </tr>
      </thead>

      <tbody>
        {challenges.map((c: any, i: number) => (
          <tr
            class="group ch-row transition-colors duration-100 cursor-pointer bg-elevated
              hover:bg-[color-mix(in_srgb,var(--elevated-color)_85%,white)]
              [&.ch-solved]:opacity-50"
            data-cat={c.category} data-name={c.title?.toLowerCase() ?? ""} data-id={c.id}
          >
            <td class={td("text-[11px] text-text/18 w-9 group-[.ch-solved]:text-[var(--diff-easy)]")}>{String(i + 1).padStart(2, "0")}</td>
            <td class={td("text-muted-text font-medium")}>{c.title}</td>
            <td class={td("", true)}>
              <span class={`inline-flex items-center gap-1 py-0.5 px-1.75 text-[10px] tracking-[0.07em] cat-${c.category}`}>
                {(() => { const Icon = CAT_MAP[c.category]?.Icon; return Icon ? <Icon size={11} /> : null; })()}
                {fmt(c.category)}
              </span>
            </td>
            <td class={td("text-[12px] text-text/45", true)}>{c.solves ?? 0}</td>
            <td class={td("font-bold text-pts", true)}>{c.points}</td>
            <td class={td("", true)}>
              <span class={`inline-flex items-center gap-1 py-0.5 px-1.75 text-[10px] tracking-[0.07em] diff-${(c.difficulty ?? "").toLowerCase()}`}>
                {c.difficulty ? fmt(c.difficulty) : "—"}
              </span>
            </td>
          </tr>
        ))}

        <tr id="ch-solved-sep" style="display:none">
          <td colspan="6" class="p-0 border-t border-b border-correct/18 bg-correct/6">
            <button
              id="ch-solved-toggle"
              style="color: var(--diff-easy)"
              class="flex items-center gap-1.5 bg-transparent border-none cursor-pointer
                text-[10px] tracking-[0.1em] py-1.5 px-3 w-full"
            >
              <span id="ch-solved-arrow" class="text-[8px] inline-flex transition-transform duration-150 [&.collapsed]:-rotate-90">▼</span>
              Solved
              <span id="ch-solved-count" class="text-correct/50"></span>
            </button>
          </td>
        </tr>
      </tbody>
    </table>
  )}
</div>
