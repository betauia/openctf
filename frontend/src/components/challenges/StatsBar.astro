---
const { count, totalSolves, totalPoints, userScore } = Astro.props;

const stats = [
  { label: "Challenges",   value: count,       accent: true,  id: null },
  { label: "Total solves", value: totalSolves, accent: true,  id: null },
  { label: "Max points",   value: totalPoints, accent: true,  id: null },
  { label: "Your score",   value: userScore ?? "—", accent: userScore !== null, id: "ch-score-val" },
  { label: "Your rank",    value: "—",         accent: false, id: null },
];
---

<div class="ch-stats">
  {stats.map(({ label, value, accent, id }) => (
    <div class="ch-stat">
      <span class="ch-stat-label">{label}</span>
      <span id={id ?? undefined} class={`ch-stat-value${accent ? "" : " ch-stat-dim"}`}>{value}</span>
    </div>
  ))}
</div>
