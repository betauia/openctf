---
const { count, totalSolves, totalPoints } = Astro.props;

const stats = [
  { label: "Challenges",    value: count,       accent: true },
  { label: "Total solves",  value: totalSolves, accent: true },
  { label: "Max points",    value: totalPoints, accent: true },
  { label: "Your score",    value: "—",         accent: false },
  { label: "Your rank",     value: "—",         accent: false },
];
---

<div class="ch-stats">
  {stats.map(({ label, value, accent }) => (
    <div class="ch-stat">
      <span class="ch-stat-label">{label}</span>
      <span class={`ch-stat-value${accent ? "" : " ch-stat-dim"}`}>{value}</span>
    </div>
  ))}
</div>
