FROM golang:1.27.3 AS base
WORKDIR /app
ENV CGO_ENABLED=0
COPY go.mod go.sum ./
RUN go mod download
COPY . .

FROM base AS development
CMD ["go", "run", "./cmd/server"]

FROM base AS build
RUN go build -trimpath -ldflags="-s -w" -o /out/backend ./cmd/server

FROM gcr.io/distroless/static-debian12 AS production
COPY --from=build /out/backend /backend
COPY --from=build /app/internal/policies/default.json /policies/default.json
ENV POLICY_FILE=/policies/default.json
EXPOSE 8000
ENTRYPOINT ["/backend"]
